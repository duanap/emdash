							"style": "h2",
							"children": [{ "_type": "span", "text": "这个站", "_key": "ak3" }],
							"_key": "ak2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "站点基于 Astro 与 EmDash 构建，前台服务端渲染，内容存放在 SQLite 中，跑在一台自己的服务器上。旧版是 Vue 3 + Fastify 的全自研方案，迁移的记录都写在文章里。",
									"_key": "ak5"
								}
							],
							"_key": "ak4"
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [{ "_type": "span", "text": "我在做什么", "_key": "ak7" }],
