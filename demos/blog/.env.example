# 部署环境变量示例（详见 night-work/DEPLOY.md）
# 复制成 .env 后按需修改；不要把真实密钥提交进仓库。

# ── 构建期 ───────────────────────────────────────────────────────────
# 这两个在 astro build 时求值并写进 server bundle，改完必须重新构建。
EMDASH_DATABASE_URL=file:./data.db
EMDASH_UPLOADS_DIR=./uploads

# ── 运行期 ───────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=4322
NODE_ENV=production

# 插件密钥（如 QQ Client Secret）的加解密密钥：设定后不要再改，
# 并跟数据库一起备份；改了需要在后台重新填写插件设置。
EMDASH_ENCRYPTION_KEY=

# 评论限流用的 IP 哈希盐与预览令牌。不设时 EmDash 会生成并存进数据库
# （随数据库一起备份），显式设置更可控。
EMDASH_IP_SALT=
EMDASH_PREVIEW_SECRET=

# 允许的来源（逗号分隔），用于来源校验，填线上域名。
EMDASH_ALLOWED_ORIGINS=
