---
import Base from "../layouts/Base.astro";
import ArchiveTimeline from "../components/ArchiveTimeline.astro";
import { getArchiveItems } from "../utils/archive-items";

const { items, postCount, lifeCount } = await getArchiveItems();
---

<Base title="归档" description="全部文章与生活记录的时间线">
	<div class="archives-page">
		<header class="page-header">
			<h1 class="page-title">归档</h1>
			<p class="page-description">
				共 {postCount} 篇文章 · {lifeCount} 条生活记录
			</p>
		</header>

		{
			items.length === 0 ? (
				<p class="empty">还没有任何内容。</p>
			) : (
				<ArchiveTimeline items={items} />
			)
		}
	</div>
</Base>

<style>
	.archives-page {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-12);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
	}

	.page-description {
		margin-top: var(--spacing-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.empty {
		color: var(--color-muted);
		text-align: center;
		padding: var(--spacing-16) 0;
	}
</style>
