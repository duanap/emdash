---
import {
	getEmDashCollection,
	getTermsForEntries,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

// Optional type filter: /projects?type=open-source
const activeType = Astro.url.searchParams.get("type") || undefined;

const termsResult = await getTaxonomyTermsWithCacheHint("project_type", {
	includeCounts: true,
});
const types = termsResult.data;
const activeTerm = activeType
	? types.find((t) => t.slug === activeType)
	: undefined;

const { entries: projects, cacheHint } = await getEmDashCollection("projects", {
	where: activeTerm ? { project_type: activeTerm.slug } : undefined,
	orderBy: { sort_order: "asc" },
	limit: 50,
});

if (Astro.cache?.enabled) Astro.cache.set(termsResult.cacheHint);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Batched type-term lookup for card labels.
const typesByEntry = await getTermsForEntries(
	"projects",
	projects.map((p) => p.data.id),
	"project_type",
);

const cards = projects.map((project) => {
	const terms = typesByEntry.get(project.data.id) ?? [];
	return {
		project,
		typeLabel: terms[0]?.label,
	};
});

const featuredCards = cards.filter(({ project }) => project.data.featured);
const gridCards = featuredCards.length > 0
	? cards.filter(({ project }) => !project.data.featured)
	: cards;
---

<Base
	title="作品"
	description="我做过的开源项目、个人项目与小工具"
>
	<div class="projects-page">
		<header class="page-header">
			<h1 class="page-title">作品</h1>
			<p class="page-description">
				{activeTerm ? activeTerm.label : "全部"} · 共 {projects.length} 个
			</p>
		</header>

		{
			types.length > 0 && (
				<nav class="type-filter" aria-label="项目类型过滤">
					<a
						href="/projects"
						class:list={["type-chip", { active: !activeTerm }]}
					>
						全部
					</a>
					{types.map((t) => (
						<a
							href={`/projects?type=${t.slug}`}
							class:list={["type-chip", { active: activeTerm?.slug === t.slug }]}
						>
							{t.label}
						</a>
					))}
				</nav>
			)
		}

		{
			cards.length === 0 ? (
				<p class="empty">这个类型下还没有作品。</p>
			) : (
				<>
					{featuredCards.length > 0 && !activeTerm && (
						<section class="featured-section">
							<h2 class="section-label">精选项目</h2>
							<div class="featured-grid" data-count={featuredCards.length}>
								{featuredCards.map(({ project, typeLabel }) => (
									<ProjectCard
										title={project.data.title ?? "未命名"}
										summary={project.data.summary}
										cover={project.data.cover_image}
										href={`/projects/${project.id}`}
										tech={project.data.tech}
										typeLabel={typeLabel}
										featured={project.data.featured}
										edit={project.edit}
									/>
								))}
							</div>
						</section>
					)}

					{gridCards.length > 0 && (
						<section class="grid-section">
							{featuredCards.length > 0 && !activeTerm && (
								<h2 class="section-label">全部作品</h2>
							)}
							<div class="projects-grid">
								{gridCards.map(({ project, typeLabel }) => (
									<ProjectCard
										title={project.data.title ?? "未命名"}
										summary={project.data.summary}
										cover={project.data.cover_image}
										href={`/projects/${project.id}`}
										tech={project.data.tech}
										typeLabel={typeLabel}
										featured={project.data.featured}
										edit={project.edit}
									/>
								))}
							</div>
						</section>
					)}
				</>
			)
		}
	</div>
</Base>

<style>
	.projects-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
	}

	.page-description {
		margin-top: var(--spacing-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.type-filter {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-10);
	}

	.type-chip {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-3);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border-radius: 999px;
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.type-chip:hover {
		color: var(--color-text);
		background: var(--color-border);
	}

	.type-chip.active {
		color: var(--color-on-brand);
		background: var(--color-brand);
	}

	.section-label {
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.featured-section {
		margin-bottom: var(--spacing-12);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-10) var(--spacing-8);
	}

	.grid-section {
		margin-bottom: var(--spacing-8);
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.empty {
		color: var(--color-muted);
		padding: var(--spacing-16) 0;
		text-align: center;
	}

	@media (max-width: 900px) {
		.featured-grid,
		.projects-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-8) var(--spacing-6);
		}
	}

	@media (max-width: 600px) {
		.featured-grid,
		.projects-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}
	}
</style>
