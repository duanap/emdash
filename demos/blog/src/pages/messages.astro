---
/**
 * 留言墙（Phase 5.2 / 5.2b）。
 *
 * 数据与审核都走 EmDash 原生评论：`wall` 集合下唯一的留言墙条目是评论目标，
 * 提交进 pending，后台「评论」页审核通过后才会出现在这里。
 *
 * 视觉沿用旧站的双轨道无缝滚动卡片墙，但落在本站的克制配色上（不加渐变底色）。
 * 轨道里只有第一半是"真"卡片（可读、可点赞），补位与副本 `aria-hidden`；
 * `prefers-reduced-motion` 下不滚动，并去掉补位与副本。
 */
import {
	getComments,
	getEmDashCollection,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { CommentForm } from "emdash/ui/comments";
import Base from "../layouts/Base.astro";
import { DEFAULT_AVATAR } from "../utils/default-images";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { buildLaneTrack, buildWallLanes } from "../utils/wall-lanes";

const { entries, cacheHint } = await getEmDashCollection("wall", {
	limit: 1,
	orderBy: { created_at: "asc" },
});
const entry = entries[0];

if (!entry) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { items, total } = await getComments({
	collection: "wall",
	contentId: entry.data.id,
});
const lanes = buildWallLanes(items).map((lane) => buildLaneTrack(lane));

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(entry, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: "/messages",
});

const formatDate = (value: string) =>
	new Date(value).toLocaleDateString("zh-CN", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "wall", id: entry.data.id, slug: entry.id }}
>
	<div class="wall-page">
		<header class="page-header">
			<h1 class="page-title" {...entry.edit.title}>{entry.data.title}</h1>
			{
				entry.data.intro && (
					<p class="page-description" {...entry.edit.intro}>
						{entry.data.intro}
					</p>
				)
			}
			<p class="page-count">共 {total} 条留言</p>
		</header>

		{
			items.length === 0 ? (
				<p class="empty">还没有留言，来做第一个吧。</p>
			) : (
				<section class="wall-stage" aria-label="已审核留言">
					{lanes.map((lane, laneIndex) => (
						<div class="lane">
							<div class:list={["lane-track", laneIndex === 1 && "reverse"]}>
								{lane.map((card) =>
									card.readable ? (
										<article
											class="message-card"
											data-comment-id={card.item.id}
										>
											<span class="quote-mark" aria-hidden="true">
												“
											</span>
											<p class="wall-body">{card.item.body}</p>
											<footer class="wall-meta">
												<img
													src={DEFAULT_AVATAR}
													alt=""
													class="wall-avatar"
													width="28"
													height="28"
													loading="lazy"
												/>
												<span class="wall-author">{card.item.authorName}</span>
												<span class="dot" aria-hidden="true">
													·
												</span>
												<time class="wall-date" datetime={card.item.createdAt}>
													{formatDate(card.item.createdAt)}
												</time>
											</footer>
										</article>
									) : (
										<article
											class="message-card"
											aria-hidden="true"
											data-wall-extra="true"
										>
											<span class="quote-mark" aria-hidden="true">
												“
											</span>
											<p class="wall-body">{card.item.body}</p>
											<footer class="wall-meta">
												<img
													src={DEFAULT_AVATAR}
													alt=""
													class="wall-avatar"
													width="28"
													height="28"
													loading="lazy"
												/>
												<span class="wall-author">{card.item.authorName}</span>
												<span class="dot" aria-hidden="true">
													·
												</span>
												<time class="wall-date" datetime={card.item.createdAt}>
													{formatDate(card.item.createdAt)}
												</time>
											</footer>
										</article>
									),
								)}
							</div>
						</div>
					))}
				</section>
			)
		}

		<section class="wall-form" aria-labelledby="wall-form-title">
			<h2 class="section-title" id="wall-form-title">写留言</h2>
			<CommentForm collection="wall" contentId={entry.data.id} />
			<p class="form-hint">邮箱只用于核对留言，不会公开展示。</p>
		</section>
	</div>
</Base>

<script>
	import { installCommentLikes } from "../scripts/comment-likes";

	// 只有第一半的卡片会拿到点赞按钮；副本与补位对读屏隐藏，也不该被点到
	installCommentLikes({
		targets: () =>
			[
				...document.querySelectorAll<HTMLElement>(
					".message-card[data-comment-id]",
				),
			].flatMap((card) => {
				const id = card.dataset.commentId;
				const meta = card.querySelector<HTMLElement>(".wall-meta");
				return id && meta ? [{ id, container: meta }] : [];
			}),
	});
</script>

<style>
	.wall-avatar {
		border-radius: 50%;
		object-fit: contain;
		flex-shrink: 0;
	}

	.wall-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-10);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		margin-bottom: var(--spacing-3);
	}

	.page-description {
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
	}

	.page-count {
		margin-top: var(--spacing-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	/* ─── 双轨道滚动墙 ────────────────────────────────────────────── */

	.wall-stage {
		display: grid;
		gap: var(--spacing-4);
		margin-bottom: var(--spacing-12);
		/* 两侧渐隐，避免卡片从硬边切出去 */
		mask-image: linear-gradient(
			to right,
			transparent,
			black 6%,
			black 94%,
			transparent
		);
	}

	.lane {
		overflow: hidden;
	}

	.lane-track {
		display: flex;
		gap: var(--spacing-4);
		width: max-content;
		animation: wall-scroll 48s linear infinite;
	}

	.lane-track.reverse {
		animation-direction: reverse;
	}

	/* 悬停或键盘进入时停下，方便读完/点赞 */
	.lane:hover .lane-track,
	.lane:focus-within .lane-track {
		animation-play-state: paused;
	}

	@keyframes wall-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.message-card {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		width: 300px;
		flex: 0 0 auto;
		padding: var(--spacing-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
	}

	.quote-mark {
		color: var(--color-border);
		font-size: var(--font-size-3xl);
		line-height: 1;
	}

	/* 动效敏感的用户看到静态网格，补位与副本一并去掉 */
	@media (prefers-reduced-motion: reduce) {
		.wall-stage {
			mask-image: none;
		}

		.lane {
			overflow: visible;
		}

		.lane-track {
			animation: none;
			width: auto;
			flex-wrap: wrap;
		}

		.message-card[data-wall-extra="true"] {
			display: none;
		}
	}

	.wall-body {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		line-height: var(--leading-relaxed);
	}

	.wall-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--spacing-2);
		margin-top: auto;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.wall-author {
		color: var(--color-text-secondary);
		font-weight: var(--font-weight-heading);
	}

	.empty {
		color: var(--color-muted);
	}

	/* ─── 写留言 ──────────────────────────────────────────────────── */

	.wall-form {
		max-width: var(--content-width);
	}

	.section-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-4);
	}

	.form-hint {
		margin-top: var(--spacing-3);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}
</style>
