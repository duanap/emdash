---
/**
 * 留言墙（Phase 5.2）。
 *
 * 数据与审核都走 EmDash 原生评论：`wall` 集合下唯一的留言墙条目是评论目标，
 * 提交进 pending，后台「评论」页审核通过后才会出现在这里。
 */
import { getComments, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { CommentForm } from "emdash/ui/comments";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const { entry, cacheHint } = await getEmDashEntry("wall", "wall");

if (!entry) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { items, total } = await getComments({ collection: "wall", contentId: entry.data.id });

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(entry, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: "/messages",
});

const formatDate = (value: string) =>
	new Date(value).toLocaleDateString("zh-CN", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "wall", id: entry.data.id, slug: "wall" }}
>
	<div class="wall-page">
		<header class="page-header">
			<h1 class="page-title" {...entry.edit.title}>{entry.data.title}</h1>
			{
				entry.data.intro && (
					<p class="page-description" {...entry.edit.intro}>
						{entry.data.intro}
					</p>
				)
			}
			<p class="page-count">共 {total} 条留言</p>
		</header>

		<section class="wall-form" aria-labelledby="wall-form-title">
			<h2 class="section-title" id="wall-form-title">写留言</h2>
			<CommentForm collection="wall" contentId={entry.data.id} />
			<p class="form-hint">邮箱只用于核对留言，不会公开展示。</p>
		</section>

		<section class="wall-list" aria-labelledby="wall-list-title">
			<h2 class="section-title" id="wall-list-title">大家的留言</h2>
			{
				items.length === 0 ? (
					<p class="empty">还没有留言，来做第一个吧。</p>
				) : (
					<ul class="wall-cards">
						{items.map((item) => (
							<li class="wall-card">
								<p class="wall-body">{item.body}</p>
								<footer class="wall-meta">
									<span class="wall-author">{item.authorName}</span>
									<time class="wall-date" datetime={item.createdAt}>
										{formatDate(item.createdAt)}
									</time>
								</footer>
							</li>
						))}
					</ul>
				)
			}
		</section>
	</div>
</Base>

<style>
	.wall-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-10);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		margin-bottom: var(--spacing-3);
	}

	.page-description {
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
	}

	.page-count {
		margin-top: var(--spacing-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.wall-form {
		max-width: var(--content-width);
		margin-bottom: var(--spacing-12);
	}

	.section-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		margin-bottom: var(--spacing-4);
	}

	.form-hint {
		margin-top: var(--spacing-3);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.wall-cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--spacing-4);
		list-style: none;
		padding: 0;
	}

	.wall-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--spacing-4);
		padding: var(--spacing-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
	}

	.wall-body {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		line-height: var(--leading-relaxed);
	}

	.wall-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--spacing-2);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.wall-author {
		color: var(--color-text-secondary);
		font-weight: var(--font-weight-heading);
	}

	.empty {
		color: var(--color-muted);
	}
</style>
