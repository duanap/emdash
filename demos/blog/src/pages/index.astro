---
import { htmlPageUrl } from "../utils/public-page-url.js";
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import HeroCarousel from "../components/HeroCarousel.astro";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { toDate } from "../utils/date";
import { selectHeroSlides } from "../utils/hero-slides";

const POSTS_PER_PAGE = 4;
const LIFE_PER_SECTION = 4;
const PROJECTS_PER_SECTION = 4;

const [postsResult, lifeResult, projectsResult, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getEmDashCollection("life", {
		orderBy: { record_date: "desc" },
		limit: LIFE_PER_SECTION,
	}),
	getEmDashCollection("projects", {
		orderBy: { sort_order: "asc" },
		limit: PROJECTS_PER_SECTION,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) {
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(lifeResult.cacheHint);
	Astro.cache.set(projectsResult.cacheHint);
}

const { entries: posts } = postsResult;
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const gridPosts = visiblePosts.slice(0, 4);
const hasMorePosts = posts.length > 3;
const articleSlides = posts
	.filter((post) => post.data.featured_image)
	.slice(0, 4)
	.map((post) => ({
		title: post.data.title ?? "未命名",
		href: `/posts/${post.id}`,
		image: post.data.featured_image,
		excerpt: post.data.excerpt,
		date: post.data.publishedAt ?? undefined,
		readingTime: getReadingTime(post.data.content),
		edit: post.edit,
	}));
const carouselSlides = selectHeroSlides(settings.heroSlides, articleSlides);
const tagsByEntry = await getTermsForEntries(
	"posts",
	gridPosts.map((post) => post.data.id),
	"tag",
);

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
	bylines: post.data.bylines ?? [],
}));

// Life records + tags for the second section.
const lifeRecords = lifeResult.entries;
const lifeTagsByEntry = await getTermsForEntries(
	"life",
	lifeRecords.map((r) => r.data.id),
	"tag",
);
const lifeCards = lifeRecords.map((record) => ({
	record,
	tags: (lifeTagsByEntry.get(record.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));

// Projects: featured ones first, then sort_order.
const allProjects = [
	...projectsResult.entries.filter((p) => p.data.featured),
	...projectsResult.entries.filter((p) => !p.data.featured),
].slice(0, PROJECTS_PER_SECTION);
const projectTypesByEntry = await getTermsForEntries(
	"projects",
	allProjects.map((p) => p.data.id),
	"project_type",
);
const projectCards = allProjects.map((project) => {
	const terms = projectTypesByEntry.get(project.data.id) ?? [];
	return { project, typeLabel: terms[0]?.label };
});
---

<Base title={siteTitle} description={siteTagline}>
	{visiblePosts.length > 0 && <h1 class="home-title">{siteTitle}</h1>}
	<HeroCarousel slides={carouselSlides} options={settings.heroCarousel} />
	<div class="home-content">
		{
			visiblePosts.length === 0 ? (
				<section class="empty-state">
					<h1>暂无内容</h1>
					<p>到管理后台创建第一篇文章吧。</p>
					<a href={htmlPageUrl("/_emdash/admin")} class="btn">
						进入后台
					</a>
				</section>
			) : (
				<>
					{/* Latest posts */}
					{gridPostsWithTags.length > 0 && (
						<section class="home-section">
							<header class="section-header">
								<h2 class="section-title">最新文章</h2>
								{hasMorePosts && (
									<a href={htmlPageUrl("/posts")} class="section-link section-link-top">
										查看全部
									</a>
								)}
							</header>
							<div class="posts-grid">
								{gridPostsWithTags.map(({ post, tags, bylines }) => (
									<PostCard
										title={post.data.title ?? "未命名"}
										excerpt={post.data.excerpt}
										featuredImage={post.data.featured_image}
										href={htmlPageUrl(`/posts/${post.id}`)}
										date={post.data.publishedAt ?? undefined}
										readingTime={getReadingTime(post.data.content)}
										tags={tags}
										bylines={bylines}
										fullMobileCover
										edit={post.edit}
									/>
								))}
							</div>
							<a href={htmlPageUrl("/posts")} class="section-link section-link-bottom">
								查看更多
							</a>
						</section>
					)}

					{/* Latest life records */}
					{lifeCards.length > 0 && (
						<section class="home-section">
							<header class="section-header">
								<h2 class="section-title">生活记录</h2>
								<a href={htmlPageUrl("/life")} class="section-link section-link-top">
									查看全部
								</a>
							</header>
							<div class="posts-grid">
								{lifeCards.map(({ record, tags }) => (
									<PostCard
										title={record.data.title ?? "未命名"}
										featuredImage={record.data.featured_image}
										href={htmlPageUrl(`/life/${record.id}`)}
										date={toDate(
											record.data.record_date ?? record.data.publishedAt,
										)}
										tags={tags}
										tagBasePath="/life/tag"
										fullMobileCover
										edit={record.edit}
									/>
								))}
							</div>
							<a href={htmlPageUrl("/life")} class="section-link section-link-bottom">
								查看更多
							</a>
						</section>
					)}

					{/* Projects */}
					{projectCards.length > 0 && (
						<section class="home-section">
							<header class="section-header">
								<h2 class="section-title">作品</h2>
								<a href={htmlPageUrl("/projects")} class="section-link section-link-top">
									查看全部
								</a>
							</header>
							<div class="posts-grid">
								{projectCards.map(({ project, typeLabel }) => (
									<ProjectCard
										title={project.data.title ?? "未命名"}
										summary={project.data.summary}
										cover={project.data.cover_image}
										href={htmlPageUrl(`/projects/${project.id}`)}
										tech={project.data.tech}
										typeLabel={typeLabel}
										featured={project.data.featured}
										fullMobileCover
										edit={project.edit}
									/>
								))}
							</div>
							<a href={htmlPageUrl("/projects")} class="section-link section-link-bottom">
								查看更多
							</a>
						</section>
					)}
				</>
			)
		}
	</div>
</Base>

<style>
	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	.home-title {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Section header */
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-title {
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
	}

	.section-link {
		font-size: var(--font-size-sm);
		color: var(--color-brand);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.section-link:hover {
		color: var(--color-brand-hover);
	}

	.home-section {
		margin-bottom: var(--spacing-16);
	}

	.home-section:last-child {
		margin-bottom: 0;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.section-link-bottom {
		display: none;
	}
	@media (min-width: 641px) {
		.posts-grid > :global(:nth-child(n + 4)) {
			display: none;
		}
	}
	/* Empty State */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state h1 {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
	}

	.empty-state p {
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-brand);
		color: var(--color-on-brand);
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 500;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand-hover);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.home-content {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-8) var(--spacing-6);
		}
	}

	@media (max-width: 640px) {
		.posts-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 24px 12px;
		}
		.posts-grid > :global(:nth-child(n + 5)) {
			display: none;
		}
		.section-link-top {
			display: none;
		}
		.section-link-bottom {
			display: table;
			margin: 24px auto 0;
			padding: 8px 24px;
			border: 1px solid var(--color-border);
			border-radius: var(--radius);
			text-align: center;
		}
	}
</style>
