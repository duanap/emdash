			}
			.site-title {
				display: flex;
				align-items: center;
				gap: var(--spacing-2);
			}
			.site-logo-fallback,
			.site-name.has-logo {
				display: none;
			}
			.registration-links a {
				display: flex;
				align-items: center;
				gap: var(--spacing-2);
			}
			.registration-links img {
				object-fit: contain;
				flex-shrink: 0;
			}
			@media (max-width: 640px) {
				:global(body) {
					padding-bottom: calc(64px + env(safe-area-inset-bottom));
				}
				.site-header {
					position: sticky;
					top: 0;
				}
				.nav {
					display: flex;
					height: 64px;
					padding: 8px 12px;
					gap: 8px;
				}
				.site-title {
					min-width: 0;
					font-size: 14px;
					flex: 1;
					gap: 6px;
				}
				.site-logo-img {
					display: block;
					width: 32px;
					height: 32px;
					margin: 0;
					object-fit: contain;
					flex-shrink: 0;
