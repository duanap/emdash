---
import { htmlPageUrl } from "../utils/public-page-url.js";
import LucideIcon from "../components/LucideIcon.astro";
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { DEFAULT_AVATAR } from "../utils/default-images";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical: htmlPageUrl(canonical, Astro.url.origin),
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header
			class="site-header"
			data-immersive={Astro.url.pathname === "/" || undefined}
		>
			<nav class="nav">
				<a href={htmlPageUrl("/")} class="site-title">
					<img
						src={siteLogo?.url ?? DEFAULT_AVATAR}
						alt=""
						class:list={["site-logo-img", { "site-logo-fallback": !siteLogo }]}
						width="40"
						height="40"
					/>
					<span class:list={["site-name", { "has-logo": !!siteLogo }]}
						>{siteTitle}</span
					>
				</a>
				<div class="nav-right">
					<div class="mobile-actions">
						<button
							type="button"
							class="header-icon"
							data-mobile-search
							aria-label="搜索"
							aria-expanded="false"
							aria-controls="mobile-search-panel"
							><LucideIcon name="search" /></button
						>
						<button
							type="button"
							class="header-icon"
							data-theme-toggle
							aria-label="切换到夜间模式"
							aria-pressed="false"><LucideIcon name="moon" /></button
						>
					</div>
					<div class="desktop-search">
						<LiveSearch
							placeholder="搜索…"
							class="site-search"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "life", "projects", "pages"]}
						/>
					</div>
					<div class="nav-links" aria-label="主要导航">
						{
							menu?.items.map((item) => (
								<a
									href={htmlPageUrl(item.url)}
									aria-current={
										Astro.url.pathname === item.url ? "page" : undefined
									}
									target={item.target}
									rel={
										item.target === "_blank" ? "noopener noreferrer" : undefined
									}
								>
									{item.label}
								</a>
							))
						}
					</div>
					<div
						class="nav-member"
						id="nav-member"
						data-plugin-base="/_emdash/api/plugins/duanap-members"
						aria-label="会员状态"
					>
						<a href={htmlPageUrl("/login")} class="nav-member-login">登录</a>
					</div>
				</div>
				{
					isLoggedIn && (
						<a href={htmlPageUrl("/_emdash/admin")} class="nav-admin">
							管理
						</a>
					)
				}
			</nav>
			<div id="mobile-search-panel" class="mobile-search-panel" hidden>
				<LiveSearch
					placeholder="搜索文章、生活和作品…"
					class="mobile-search"
					inputClass="mobile-search-input"
					resultsClass="site-search-results"
					resultClass="site-search-result"
					collections={["posts", "life", "projects", "pages"]}
				/>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-grid">
					<div class="footer-brand">
						<a href={htmlPageUrl("/")} class="footer-logo">
							{
								siteLogo ? (
									<img
										src={siteLogo.url}
										alt={siteLogo.alt || siteTitle}
										class="footer-logo-img"
									/>
								) : (
									siteTitle
								)
							}
						</a>
						<p class="footer-tagline">{siteTagline}</p>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">ICP备案、公安备案</h2>
						<ul class="footer-links registration-links">
							{
								settingsResult.data.footerLinks?.map((link) => (
									<li>
										<a
											href={htmlPageUrl(link.url)}
											target="_blank"
											rel="noopener noreferrer"
										>
											{link.iconUrl && (
												<img
													src={link.iconUrl}
													alt=""
													width="20"
													height="20"
													loading="lazy"
												/>
											)}
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">订阅</h2>
						<ul class="footer-links">
							<li><a href={htmlPageUrl("/rss.xml")}>RSS 订阅</a></li>
							<li><a href={htmlPageUrl("/sitemap.xml")}>网站地图</a></li>
						</ul>
					</div>
				</div>
			</div>
		</footer>

		<script>
			import { installSiteChrome } from "../scripts/site-chrome";
			installSiteChrome();
		</script>
		<nav class="mobile-nav" aria-label="底部导航">
			{
				menu?.items.map((item) => (
					<a
						href={htmlPageUrl(item.url)}
						target={item.target}
						rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						aria-current={Astro.url.pathname === item.url ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: color-mix(in srgb, var(--color-bg) 65%, transparent);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-bottom: 1px solid var(--color-border-subtle);
				transition:
					background-color 180ms ease,
					border-color 180ms ease;
			}

			:global(body:has([data-hero-carousel])) .site-header[data-immersive] {
				position: fixed;
				inset-inline: 0;
			}

			:global(body:has([data-hero-carousel]))
				.site-header[data-immersive]:not([data-scrolled="true"]) {
				background: transparent;
				backdrop-filter: none;
				-webkit-backdrop-filter: none;
				border-color: transparent;
			}

			:global(body:has([data-hero-carousel]))
				.site-header[data-immersive]:not([data-scrolled="true"])
				:is(
					.site-title,
					.nav-links > a,
					.nav-member-login,
					.nav-member-btn,
					.nav-admin,
					.header-icon
				) {
				color: #fffdf7;
				text-shadow: 0 1px 6px rgb(0 0 0 / 25%);
			}

			:global(body:has([data-hero-carousel]))
				.site-header[data-immersive]:not([data-scrolled="true"])
				.desktop-search
				:global(.site-search-input) {
				background: rgb(255 255 255 / 12%);
				border-color: rgb(255 255 255 / 28%);
				color: #fffdf7;
			}

			:global(body:has([data-hero-carousel]))
				.site-header[data-immersive]:not([data-scrolled="true"])
				.desktop-search
				:global(.site-search-input)::placeholder {
				color: rgb(255 253 247 / 75%);
			}

			.nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-4) var(--spacing-6);
				height: var(--nav-height);
			}

			.site-title {
				font-size: var(--font-size-lg);
				font-weight: 600;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: var(--tracking-snug);
			}

			.site-title:hover {
				color: var(--color-brand);
			}

			.site-logo-img {
				height: 48px;
				width: auto;
				display: block;
				margin: -8px 0;
			}

			.nav-right {
				display: flex;
				align-items: center;
				gap: var(--spacing-6);
				margin-inline-start: auto;
			}

			.nav-links {
				display: flex;
				gap: var(--spacing-5);
				font-size: var(--font-size-sm);
			}

			.nav-links a {
				text-decoration: none;
				color: var(--color-text);
				transition: color var(--transition-fast);
			}

			.nav-links a:hover {
				color: var(--color-brand);
			}

			.nav-admin {
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			.nav-admin:hover {
				color: var(--color-text);
			}

			/* 会员岛（页头） */
			.nav-member {
				position: relative;
				font-size: var(--font-size-sm);
			}

			.nav-member-login {
				color: var(--color-text-secondary);
				text-decoration: none;
				white-space: nowrap;
			}

			.nav-member-login:hover {
				color: var(--color-text);
			}

			.nav-member-btn {
				display: inline-flex;
				align-items: center;
				gap: var(--spacing-2);
				background: transparent;
				border: none;
				padding: var(--spacing-1) 0;
				cursor: pointer;
				color: var(--color-text);
			}

			.nav-member-avatar {
				width: 22px;
				height: 22px;
				border-radius: 50%;
				object-fit: cover;
			}

			.nav-member-name {
				max-width: 8em;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.nav-member-menu {
				position: absolute;
				top: calc(100% + var(--spacing-2));
				end: 0;
				min-width: 140px;
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
				padding: var(--spacing-2);
				z-index: 200;
				display: flex;
				flex-direction: column;
				gap: var(--spacing-1);
			}

			.nav-member-menu a {
				padding: var(--spacing-2) var(--spacing-3);
				color: var(--color-text);
				text-decoration: none;
				border-radius: var(--radius);
				font-weight: 500;
			}

			.nav-member-menu a:hover {
				background: var(--color-surface);
			}

			.nav-member-logout {
				text-align: start;
				padding: var(--spacing-2) var(--spacing-3);
				background: transparent;
				border: none;
				color: var(--color-text-secondary);
				border-radius: var(--radius);
				cursor: pointer;
				font-size: var(--font-size-sm);
			}

			.nav-member-logout:hover {
				background: var(--color-surface);
				color: var(--color-text);
			}

			/* Search styling */
			.site-search {
				position: relative;
				width: var(--search-input-width);
				--emdash-search-border-focus: var(--color-brand);
			}

			:global(.site-search-input) {
				width: var(--search-input-width);
				padding: var(--spacing-2) var(--spacing-3);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				background: var(--color-bg);
				color: var(--color-text);
				transition:
					border-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			:global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-brand) !important;
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: var(--spacing-2);
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 500;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
			}

			main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}

			/* Footer */
			.site-footer {
				background: var(--color-bg-subtle);
				border-top: 1px solid var(--color-border-subtle);
			}

			.footer-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-16) var(--spacing-6) var(--spacing-8);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: var(--spacing-12);
				margin-bottom: 0;
			}

			.footer-brand {
				max-width: none;
				min-width: 0;
			}

			.footer-logo {
				font-size: var(--font-size-lg);
				font-weight: 600;
				color: var(--color-text);
				text-decoration: none;
				letter-spacing: var(--tracking-snug);
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-tagline {
				margin-top: var(--spacing-3);
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				line-height: var(--leading-relaxed);
			}

			.footer-nav {
				min-width: 0;
			}

			.footer-heading {
				font-size: var(--font-size-xs);
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wider);
				color: var(--color-muted);
				margin-bottom: var(--spacing-4);
			}

			.footer-links {
				list-style: none;
			}

			.footer-links li {
				margin-bottom: var(--spacing-2);
			}

			.footer-links a {
				overflow-wrap: anywhere;
				color: var(--color-text-secondary);
				text-decoration: none;
				font-size: var(--font-size-sm);
				transition: color var(--transition-fast);
			}

			.footer-links a:hover {
				color: var(--color-text);
			}

			.footer-widgets-section :global(.widget-area) {
				display: block;
			}

			.footer-widgets-section :global(.widget) {
				color: var(--color-text-secondary);
			}

			.footer-widgets-section :global(.widget__title) {
				font-size: var(--font-size-xs);
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wider);
				color: var(--color-muted);
				margin-bottom: var(--spacing-4);
			}

			.footer-widgets-section :global(.widget__content) {
				color: var(--color-text-secondary);
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: var(--spacing-6);
				border-top: 1px solid var(--color-border);
			}

			.footer-copyright {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

