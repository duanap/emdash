					color: var(--color-muted);
					border-radius: var(--radius);
				}
				.mobile-nav a[aria-current="page"] {
					color: var(--color-brand);
					background: var(--color-surface);
					font-weight: 600;
				}
				.mobile-nav a:focus-visible {
					outline: 2px solid var(--color-brand-ring);
					outline-offset: -2px;
				}
				.footer-grid {
					grid-template-columns: minmax(0, 1fr);
					gap: var(--spacing-4);
				}
				.footer-brand {
					grid-column: span 1;
				}
				.footer-bottom {
					flex-direction: column;
					gap: var(--spacing-4);
					text-align: center;
				}
			}
		</style>

		<script>
			// 核心公开 UI 的中文兜底（评论/搜索/归档 widget），实现见 src/scripts/zh-copy.ts
			import { installZhCopy } from "../scripts/zh-copy";
			installZhCopy(document);
		</script>
		<script>
			// 页头会员岛：客户端拉取登录态（保持页面可缓存）。
			// 已登录显示昵称下拉（查看/退出），未登录显示登录链接。
			(function () {
				const el = document.getElementById("nav-member");
				const base = el?.dataset.pluginBase;
				if (!el || !base) return;
				const host: HTMLElement = el;

				async function render() {
					try {
						const res = await fetch(`${base}/auth/status`);
						const json = await res.json();
						// 宿主信封 { success, data } 包裹 handler 返回值，取内层
						const data = json?.data?.data ?? json?.data;
						if (!data || !data.loggedIn || !data.member) return; // 保持默认登录链接
						const m = data.member;

						// 会员评论：预填派生身份（邮箱由 openid 派生、不公开），
						// 服务端 comment:afterCreate 据此把评论记进会员名下
						const identity = data.commentIdentity;
						if (identity?.email) {
							for (const form of document.querySelectorAll(
								".ec-comment-form",
							)) {
								const nameInput = form.querySelector<HTMLInputElement>(
									'input[name="authorName"]',
								);
								const emailInput = form.querySelector<HTMLInputElement>(
									'input[name="authorEmail"]',
								);
								if (nameInput) {
									nameInput.value = identity.name ?? "";
									nameInput.readOnly = true;
								}
								if (emailInput) {
									emailInput.value = identity.email;
									emailInput.readOnly = true;
								}
								if (!form.querySelector(".ec-member-identity")) {
									const hint = document.createElement("p");
									hint.className = "ec-member-identity";
									hint.textContent = `以会员身份评论：${identity.name ?? ""}（邮箱不会公开）`;
									form.prepend(hint);
								}
							}
						}
						const toggle = document.createElement("button");
						toggle.type = "button";
						toggle.className = "nav-member-btn";
						toggle.setAttribute("aria-haspopup", "true");
						toggle.setAttribute("aria-expanded", "false");
						const avatar = document.createElement("img");
						avatar.src = m.avatarUrl || "/defaults/user-avatar.png";
						avatar.alt = "";
						avatar.className = "nav-member-avatar";
						toggle.append(avatar);
						const name = document.createElement("span");
						name.className = "nav-member-name";
						name.textContent = m.displayName;
						toggle.append(name);
						const dropdown = document.createElement("div");
						dropdown.className = "nav-member-menu";
						dropdown.hidden = true;
						const memberLink = document.createElement("a");
						memberLink.href = "/member";
						memberLink.textContent = m.displayName;
						const logout = document.createElement("button");
						logout.type = "button";
						logout.className = "nav-member-logout";
						logout.textContent = "退出登录";
						dropdown.append(memberLink, logout);
						host.replaceChildren(toggle, dropdown);
						const btn =
							host.querySelector<HTMLButtonElement>(".nav-member-btn");
						const menu = host.querySelector<HTMLElement>(".nav-member-menu");
						btn?.addEventListener("click", () => {
							if (!menu) return;
							const open = !menu.hidden;
							menu.hidden = open;
							btn.setAttribute("aria-expanded", String(!open));
						});
						document.addEventListener("click", (e) => {
							if (host.contains(e.target as Node) || !menu) return;
							menu.hidden = true;
							btn?.setAttribute("aria-expanded", "false");
						});
						host
							.querySelector(".nav-member-logout")
							?.addEventListener("click", async () => {
								await fetch(`${base}/auth/logout`, { method: "POST" });
								location.reload();
							});
					} catch {
						// 状态获取失败保持登录链接
					}
				}
				render();
			})();
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
