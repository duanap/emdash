				.site-name,
				.site-name.has-logo {
					display: block;
					overflow: hidden;
					text-overflow: ellipsis;
					white-space: nowrap;
				}
				.nav-right {
					display: flex;
					margin: 0;
					gap: 4px;
					flex-shrink: 0;
				}
				.nav-links,
				.nav-admin,
				.desktop-search {
					display: none;
				}
				.mobile-actions {
					display: flex;
					gap: 2px;
				}
				.header-icon {
					display: grid;
					place-items: center;
					width: 36px;
					height: 40px;
					border: 0;
					border-radius: var(--radius);
					color: var(--color-text);
					background: transparent;
					cursor: pointer;
				}
				.header-icon:hover,
				.header-icon[aria-pressed="true"] {
					color: var(--color-brand);
					background: var(--color-surface);
				}
				.header-icon:focus-visible {
					outline: 2px solid var(--color-brand-ring);
				}
