---
import { htmlPageUrl } from "../utils/public-page-url.js";
import LucideIcon from "./LucideIcon.astro";
import { heroImageSources, type HeroSlide, type HeroCarouselOptions } from "../utils/hero-slides.js";
import { Image } from "emdash/ui";
import { resolveCover } from "../utils/default-images";

interface Props {
	slides: HeroSlide[];
	options?: HeroCarouselOptions;
}

const { slides, options = {} } = Astro.props;
const position = options.textPosition ?? "bottom-start";
const style = {
	"--hero-blur": `${options.blurPx ?? 0}px`,
	"--hero-overlay": (options.overlayOpacity ?? 70) / 100,
	"--hero-title-size": options.titleSize ? `${options.titleSize}px` : "clamp(2.15rem, 4.3vw, 4.4rem)",
	"--hero-mobile-title-size": options.mobileTitleSize ? `${options.mobileTitleSize}px` : "clamp(16px, 4.8vw, 23px)",
	"--hero-description-size": `${options.descriptionSize ?? 17}px`,
	"--hero-height": options.height ? `${options.height}px` : "auto",
	"--hero-mobile-height": options.mobileHeight ? `${options.mobileHeight}px` : "auto",
	"--hero-justify": position.startsWith("top") ? "flex-start" : position.startsWith("bottom") ? "flex-end" : "center",
	"--hero-align": position.endsWith("start") ? "flex-start" : position.endsWith("end") ? "flex-end" : "center",
	"--hero-text-align": position.endsWith("start") ? "start" : position.endsWith("end") ? "end" : "center",
};
if (slides.length === 0) return null;
const formatDate = (date: Date) =>
	date.toLocaleDateString("zh-CN", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<section
	class="hero-carousel"
	data-hero-carousel
	data-hero-interval={(options.intervalSeconds ?? 7) * 1000}
	style={style}
	role="region"
	aria-roledescription="轮播"
	aria-label="首页精选内容"
>
	<div class="hero-slides">
		{
			slides.map((slide, index) => {
				const image = resolveCover(slide.image, "posts");
				const optimized = heroImageSources(image);
				const src = optimized?.src ?? (typeof image === "string" ? image : image?.src);
				return (
				<article
					class:list={["hero-slide", { "is-active": index === 0 }]}
					data-hero-slide
					data-slide-title={slide.title}
					role="group"
					aria-roledescription="幻灯片"
					aria-label={`第 ${index + 1} 张，共 ${slides.length} 张`}
					aria-hidden={index !== 0 ? "true" : "false"}
					inert={index !== 0}
				>
					<a class="hero-slide-link" href={htmlPageUrl(slide.href)} aria-label={slide.title}>
						<div class="hero-media" {...slide.edit?.featured_image}>
							{src ? <img
								src={index === 0 ? src : undefined}
								srcset={index === 0 ? optimized?.srcset : undefined}
								data-hero-src={src}
								data-hero-srcset={optimized?.srcset}
								data-hero-original={typeof image === "string" ? image : image?.src}
								alt={typeof image === "object" ? image.alt ?? slide.title : slide.title}
								fetchpriority={index === 0 ? "high" : "low"}
								decoding="async" sizes="100vw"
							/> : <Image image={image} priority={index === 0} sizes="100vw" />}
						</div>
						<div class="hero-shade" aria-hidden="true" />
						<div class="hero-content">
							<p class="hero-eyebrow">
								<span aria-hidden="true" />
								{slide.readingTime ? "精选文章" : "精选推荐"}
							</p>
							<h2 class="hero-title" {...slide.edit?.title}>
								{slide.title}
							</h2>
							{slide.excerpt && (
								<p class="hero-excerpt" {...slide.edit?.excerpt}>
									{slide.excerpt}
								</p>
							)}
							<div class="hero-meta">
								{slide.date && (
									<time datetime={slide.date.toISOString()}>
										{formatDate(slide.date)}
									</time>
								)}
								{slide.readingTime && <span>{slide.readingTime} 分钟阅读</span>}
							</div>
							<span class="hero-read">
								{slide.readingTime ? "阅读全文" : "了解更多"}
								<LucideIcon name="arrow-up-right" />
							</span>
						</div>
					</a>
				</article>
			);})
		}
	</div>
	{
		slides.length > 1 && (
			<div class="hero-controls" data-hero-controls hidden>
				<div class="hero-dots" aria-label="选择轮播图">
					{slides.map((slide, index) => (
						<button
							class="hero-dot"
							type="button"
							data-hero-dot={index}
							aria-label={`显示第 ${index + 1} 张：${slide.title}`}
							aria-current={index === 0 ? "true" : "false"}
						>
							<span aria-hidden="true" />
						</button>
					))}
				</div>
				<div class="hero-actions">
					<span class="hero-count" data-hero-count aria-hidden="true">
						01 / {String(slides.length).padStart(2, "0")}
					</span>
					<button
						type="button"
						class="hero-control hero-rotation"
						data-hero-rotation
						aria-label="暂停自动轮播"
					>
						<span data-hero-rotation-label>暂停</span>
					</button>
					<button
						type="button"
						class="hero-control"
						data-hero-prev
						aria-label="上一张"
					>
						<LucideIcon name="chevron-left" />
					</button>
					<button
						type="button"
						class="hero-control"
						data-hero-next
						aria-label="下一张"
					>
						<LucideIcon name="chevron-right" />
					</button>
				</div>
			</div>
		)
	}
	<p
		class="hero-announcement"
		data-hero-announcement
		aria-live="polite"
		aria-atomic="true"
	>
	</p>
</section>

<script>
	import { installHeroCarousel } from "../scripts/hero-carousel.js";
	document
		.querySelectorAll<HTMLElement>("[data-hero-carousel]")
		.forEach((root) => installHeroCarousel(root));
</script>

<style>
	.hero-carousel {
		--hero-ink: #fffdf7;
		--hero-shadow: #0b1712;
		position: relative;
		isolation: isolate;
		inline-size: 100%;
		block-size: var(--hero-height, auto);
		aspect-ratio: var(--hero-aspect-ratio, 16 / 9);
		overflow: hidden;
		background: var(--hero-shadow);
		color: var(--hero-ink);
		touch-action: pan-y pinch-zoom;
	}
	.hero-slides,
	.hero-slide,
	.hero-media,
	.hero-shade {
		position: absolute;
		inset: 0;
	}
	.hero-slide {
		opacity: 0;
		pointer-events: none;
		transition: opacity 650ms ease;
	}
	.hero-slide.is-active {
		opacity: 1;
		pointer-events: auto;
		z-index: 1;
	}
	.hero-slide-link {
		display: block;
		block-size: 100%;
		color: inherit;
		text-decoration: none;
	}
	.hero-slide-link:hover {
		color: inherit;
	}
	.hero-slide-link:focus-visible {
		outline: 3px solid var(--hero-ink);
		outline-offset: -6px;
	}
	.hero-media :global(img) {
		inline-size: 100%;
		block-size: 100%;
		object-fit: contain;
		filter: blur(var(--hero-blur, 0px));
	}
	.hero-shade {
		background: rgb(11 23 18 / var(--hero-overlay, 0.7));
	}
	.hero-content {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: var(--hero-justify, flex-end);
		align-items: var(--hero-align, flex-start);
		text-align: var(--hero-text-align, start);
		block-size: 100%;
		max-inline-size: var(--wide-width);
		margin-inline: auto;
		padding: 88px 48px 72px;
	}
	.hero-content > * {
		flex-shrink: 0;
	}
	.hero-eyebrow {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-block-end: 18px;
		font-size: 13px;
		letter-spacing: 0.18em;
	}
	.hero-eyebrow span {
		inline-size: 30px;
		block-size: 1px;
		background: currentColor;
		opacity: 0.65;
	}
	.hero-title {
		max-inline-size: 26ch;
		font-size: var(--hero-title-size);
		line-height: 1.18;
		font-weight: 600;
		text-wrap: balance;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.hero-excerpt {
		max-inline-size: 48ch;
		margin-block-start: 22px;
		font-size: var(--hero-description-size);
		line-height: 1.8;
		color: rgb(255 253 247 / 85%);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		margin-block-start: 22px;
		font-size: 12px;
		color: rgb(255 253 247 / 72%);
	}
	.hero-read {
		display: inline-flex;
		align-items: center;
		gap: 28px;
		margin-block-start: 22px;
		padding-block: 8px;
		border-block-end: 1px solid rgb(255 253 247 / 60%);
		font-size: 14px;
	}
	.hero-read span {
		font-size: 22px;
		transition: transform 200ms ease;
	}
	.hero-slide-link:hover .hero-read span {
		transform: translate(2px, -2px);
	}
	.hero-controls {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 30px;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-inline-size: var(--wide-width);
		margin-inline: auto;
		padding-inline: 48px;
	}
	.hero-controls[hidden] {
		display: none;
	}
	.hero-dots,
	.hero-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.hero-dot,
	.hero-control {
		color: inherit;
		background: transparent;
		cursor: pointer;
		font: inherit;
		border: 1px solid rgb(255 253 247 / 35%);
	}
	.hero-dot {
		inline-size: 44px;
		block-size: 44px;
		padding: 8px 0;
		border: 0;
	}
	.hero-dot span {
		display: block;
		block-size: 2px;
		background: rgb(255 253 247 / 35%);
		transition: background 200ms ease;
	}
	.hero-dot[aria-current="true"] span {
		background: var(--hero-ink);
	}
	.hero-control {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-inline-size: 44px;
		block-size: 44px;
		border-radius: 50%;
	}
	.hero-control:hover {
		background: rgb(255 253 247 / 12%);
		border-color: var(--hero-ink);
	}
	.hero-rotation {
		border-radius: 999px;
		padding-inline: 16px;
		font-size: 12px;
	}
	.hero-count {
		padding-inline-end: 12px;
		font-family: var(--font-mono);
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		color: rgb(255 253 247 / 72%);
	}
	.hero-control:focus-visible,
	.hero-dot:focus-visible {
		outline: 2px solid var(--hero-ink);
		outline-offset: 4px;
	}
	.hero-announcement {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	@media (max-width: 600px) {
		.hero-carousel {
			block-size: var(--hero-mobile-height, auto);
		}
		.hero-content {
			padding: 64px 20px 48px;
		}
		.hero-eyebrow {
			display: none;
		}
		.hero-title {
			max-inline-size: 100%;
			font-size: var(--hero-mobile-title-size);
			-webkit-line-clamp: 2;
		}
		.hero-excerpt {
			margin-block-start: 4px;
			line-height: 1.3;
			-webkit-line-clamp: 1;
		}
		.hero-meta {
			display: none;
		}
		.hero-read {
			margin-block-start: 4px;
			font-size: 11px;
			padding-block: 2px;
		}
		.hero-controls {
			padding-inline: 24px;
			inset-block-end: 8px;
		}
		.hero-dots {
			gap: 6px;
		}
		.hero-dot {
			inline-size: 26px;
		}
		.hero-actions {
			gap: 6px;
		}
		.hero-control {
			inline-size: 32px;
			block-size: 32px;
		}
		.hero-rotation {
			padding-inline: 10px;
		}
		.hero-count {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-slide,
		.hero-dot span,
		.hero-read span {
			transition: none;
		}
		.hero-slide-link:hover .hero-read span {
			transform: none;
		}
	}
</style>
