---
/**
 * 评论点赞（Phase 5.4c2）。
 *
 * 评论列表由 core 的 `Comments` 组件渲染，这里在客户端给每条评论补一个会员维度的
 * 点赞按钮（core 自带的 reactions 是另一套、且不是会员归属）。按钮行为与批量取状态
 * 的实现在 `src/scripts/comment-likes.ts`，与留言墙共用。
 *
 * 组件本身不渲染标记，只挂一段脚本。
 */
---

<script>
	import { installCommentLikes } from "../scripts/comment-likes";

	installCommentLikes({
		targets: () =>
			[...document.querySelectorAll<HTMLElement>(".ec-comment[data-comment-id]")].flatMap(
				(comment) => {
					const id = comment.dataset.commentId;
					if (!id) return [];
					let actions = comment.querySelector<HTMLElement>(".ec-comment-actions");
					if (!actions) {
						actions = document.createElement("div");
						actions.className = "ec-comment-actions";
						comment.append(actions);
					}
					return [{ id, container: actions }];
				},
			),
	});
</script>
